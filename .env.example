# Read by docker-compose.yml when you run `docker compose up`.
# Copy this file to `.env` (same folder as docker-compose.yml) and fill it in.

# Required — generate your own, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

JWT_EXPIRES_IN=1d

# Origin the backend will accept requests from (the frontend container, as
# the browser sees it).
FRONTEND_URL=http://localhost:5173

# Base URL the frontend bundle is built to call (the backend container, as
# the browser sees it). Baked into the frontend image at build time.
VITE_API_URL=http://localhost:3000

# Optional: enables Google sign-in. Leave both unset to keep it disabled.
# Must be the SAME client ID on both sides.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
