# Base URL of the AgriPulse backend API (Express, no trailing slash).
# Copy this file to `.env` and adjust for your environment.
VITE_API_URL=http://localhost:3000

# Set to true to sign in WITHOUT a backend (dev server only, accounts are kept
# in this browser's localStorage). Leave false when the NestJS API is running.
VITE_USE_MOCK_AUTH=false
