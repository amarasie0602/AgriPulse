# Base URL of the AgriPulse backend API (Express, no trailing slash).
# Copy this file to `.env` and adjust for your environment.
VITE_API_URL=http://localhost:3000

# Set to true to sign in WITHOUT a backend (dev server only, accounts are kept
# in this browser's localStorage). Leave false when the Express API is running.
VITE_USE_MOCK_AUTH=false

# Optional: enables the "Continue with Google" button. Must be the SAME
# client ID as the backend's GOOGLE_CLIENT_ID. Create one at
# https://console.cloud.google.com/apis/credentials ("Create credentials" ->
# "OAuth client ID" -> "Web application", with http://localhost:5173 under
# "Authorized JavaScript origins"). Leave unset to keep the button disabled.
VITE_GOOGLE_CLIENT_ID=
