# Local MongoDB only — no hosted/online database service (e.g. Atlas) is used.
# Install MongoDB Community Server or run it via Docker:
#   docker run -d --name agripulse-mongo -p 27017:27017 -v agripulse-mongo-data:/data/db mongo:7
MONGODB_URI="mongodb://127.0.0.1:27017/agripulse"

# Secret used to sign JWTs. Generate your own, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-value"
JWT_EXPIRES_IN="1d"

# Origin allowed to call this API (the Vite dev server by default).
FRONTEND_URL="http://localhost:5173"

PORT=3000

# Optional: enables POST /auth/google (Google sign-in / sign-up).
# Must be the SAME client ID as the frontend's VITE_GOOGLE_CLIENT_ID.
# Create one at https://console.cloud.google.com/apis/credentials
# ("Create credentials" -> "OAuth client ID" -> "Web application", with
# http://localhost:5173 under "Authorized JavaScript origins").
# Leave unset to keep Google sign-in disabled.
GOOGLE_CLIENT_ID=
